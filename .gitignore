# ulauncher writes into its own config directory, which this repo symlinks into
# place -- so its runtime state lands here rather than in ~/.config.
#
# generated.css is the stylesheet ulauncher compiles from the theme's
# extend_theme chain. For a *user* theme it is written into the theme directory
# itself (Theme._get_path_for_generated_css), not into ~/.cache, so it appears
# under ui/ulauncher/. It is a build artifact of theme.css and nothing reads it
# but ulauncher.
ui/ulauncher/user-themes/*/generated.css

# Written when an extension's preferences are first set.
ui/ulauncher/ext_preferences/
