# ============================================================
# Sway configuration
# ============================================================

### Variables

set $mod Mod4

set $terminal alacritty
set $launcher ulauncher-toggle
set $filemanager nautilus

set $menu $launcher

### Environment

# The distro default config ends with this include; a hand-written config that
# drops it loses the sway-systemd integration in /etc/sway/config.d, which runs
# session.sh to start sway-session.target (bound to graphical-session.target),
# export XDG_CURRENT_DESKTOP=sway / XDG_SESSION_TYPE=wayland, and propagate
# WAYLAND_DISPLAY/SWAYSOCK to systemd and dbus. Without it graphical-session
# .target never activates, and xdg-desktop-portal — which has Requisite= on it —
# can never start, taking dark-mode appearance, screen sharing and native file
# pickers down with it.
include /etc/sway/config.d/*

### Startup

exec_always sh -c 'pkill -x waybar; exec waybar'
exec_always mako
exec_always /usr/libexec/polkit-gnome-authentication-agent-1

### Default terminal

bindsym $mod+Return exec $terminal
bindsym $mod+Shift+Return exec $terminal -e "$HOME/scripts/tmux-sessionizer"

### Application launcher

bindsym $mod+d exec $menu

### File manager

bindsym $mod+Shift+f exec $filemanager

