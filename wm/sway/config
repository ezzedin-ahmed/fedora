### Resize mode

mode "resize" {
    bindsym h resize shrink width 10 px
    bindsym j resize grow height 10 px
    bindsym k resize shrink height 10 px
    bindsym l resize grow width 10 px

    bindsym Left resize shrink width 10 px
    bindsym Down resize grow height 10 px
    bindsym Up resize shrink height 10 px
    bindsym Right resize grow width 10 px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

### Screenshots

# ~/scripts is on PATH via fish/config.fish, so these are bare names. The old
# binding pointed at ~/fedora/dotfiles/sway/scripts/screenshot, a path from a
# layout this repo no longer uses -- Print silently did nothing.
bindsym Print exec screenshot
bindsym Shift+Print exec screenshot-window
bindsym $mod+Print exec screen-record

### Audio

bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle

### Media

bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

### Brightness

bindsym XF86MonBrightnessUp exec brightnessctl set +10%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

### Lock

# gtklock over swaylock: swaylock draws only a ring, with no field to type into.
# gtklock is an ext-session-lock client, so the compositor owns the lock and a
# crashed locker cannot fall through to the desktop. Styling: wm/gtklock/.
set $lock gtklock -d

bindsym $mod+Escape exec $lock

### Idle

# before-sleep is the important one on a laptop: with no bindswitch here, closing
# the lid falls through to logind's HandleLidSwitch=suspend, and this is the only
# thing between the lid opening again and a live session.
exec swayidle \
    -w \
    timeout 300 '$lock' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep '$lock'

### Keyboard

# Plain `ara` keeps Latin digits on the number row; the Arabic-Indic ones sit on
# level 3 (AltGr). The `ara(digits)` variants are the opposite — they put Eastern
# Arabic numerals on the unshifted row — so no variant is set here on purpose.
input type:keyboard {
    xkb_layout "us,ara"
    xkb_options "grp:alt_shift_toggle,caps:swapescape"
    # Defaults are 600ms/25Hz; snappier hold-to-repeat.
    repeat_delay 200
    repeat_rate 40
}

### Mouse/touchpad

input type:touchpad {
    tap enabled
    natural_scroll disabled
}

### Appearance

default_border none
default_floating_border none

# Wallpaper lives in the repo so it survives ~/Downloads being cleared.
