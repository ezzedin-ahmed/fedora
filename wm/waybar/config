{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,
  "modules-left": [
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-center": [],
  "modules-right": [
    "group/stats",
    "idle_inhibitor",
    "custom/language",
    "tray",
    "group/network",
    "bluetooth",
    "battery",
    "clock",
    "group/power"
  ],
  "group/stats": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "children-class": "drawer-child",
      "click-to-reveal": false,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/stats",
      "cpu",
      "memory",
      "pulseaudio",
      "backlight"
    ]
  },
  "custom/stats": {
    "format": "",
    "tooltip": false
  },
  "group/network": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "children-class": "drawer-child",
      "click-to-reveal": false,
      "transition-left-to-right": false
    },
    "modules": [
      "network#icon",
      "network#name"
    ]
  },
  "network#icon": {
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format": "{essid}  {ipaddr}",
    "on-click": "alacritty --class nmtui -e nmtui connect"
  },
  "network#name": {
    "format-wifi": "{essid}",
    "format-ethernet": "{ipaddr}",
    "format-disconnected": "offline",
    "tooltip": false,
    "on-click": "alacritty --class nmtui -e nmtui connect"
  },
  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{name}"
  },
  "sway/mode": {
    "format": "{}"
  },
  "custom/language": {
    "exec": "~/scripts/kblayout",
    "return-type": "json",
    "format": "  {}",
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "cpu": {
    "format": " {usage}%",
    "interval": 5
  },
  "memory": {
    "format": "󰍛 {}%",
    "interval": 5
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "backlight": {
    "format": "󰃟 {percent}%"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "{device_alias}",
    "on-click": "blueman-manager"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂑 {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰂂",
      "󰁹"
    ]
  },
  "tray": {
    "spacing": 10
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "group/power": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "children-class": "drawer-child",
      "click-to-reveal": false,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/power",
      "custom/lock",
      "custom/logout",
      "custom/suspend",
      "custom/reboot",
      "custom/shutdown"
    ]
  },
  "custom/power": {
    "format": "",
    "tooltip": false
  },
  "custom/lock": {
    "format": "",
    "tooltip": false,
    "on-click": "gtklock -d"
  },
  "custom/logout": {
    "format": "",
    "tooltip": false,
    "on-click": "swaymsg exit"
  },
  "custom/suspend": {
    "format": "",
    "tooltip": false,
    "on-click": "systemctl suspend"
  },
  "custom/reboot": {
    "format": "",
    "tooltip": false,
    "on-click": "systemctl reboot"
  },
  "custom/shutdown": {
    "format": "",
    "tooltip": false,
    "on-click": "systemctl poweroff"
  }
}
