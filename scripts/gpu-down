#!/usr/bin/env bash
# gpu-down — unload the NVIDIA driver so the Quadro drops back to D3hot.
#
# This is the only manual step the discrete GPU needs, and the only one it has:
# the card cannot power itself down (see nvidia/ for the hardware reason), and
# anything that wants it -- a CUDA process via the nvidia-modprobe helper, or
# prime-run -- brings the driver up on its own. Nothing brings it back, so
# without this the card sits at D0 for the rest of the session.

set -Eeuo pipefail

# The Quadro has no display attached, so it shows up under either PCI class
# depending on the machine. Derived rather than hardcoded, so this survives the
# card moving on the bus.
dev=$(lspci -D -d 10de: | grep -E 'VGA compatible controller|3D controller' |
  head -1 | cut -d' ' -f1)
if [ -z "$dev" ]; then
  echo "gpu-down: no NVIDIA GPU on the PCI bus" >&2
  exit 1
fi

state() { cat "/sys/bus/pci/devices/$dev/power_state"; }

if ! lsmod | grep -q '^nvidia '; then
  echo "NVIDIA driver already unloaded. PCI power state: $(state)"
  exit 0
fi

# Anything still holding the device keeps modprobe -r from succeeding, and the
# error alone does not say who. Name them first.
if procs=$(nvidia-smi --query-compute-apps=pid,process_name --format=csv,noheader 2>/dev/null) &&
  [ -n "$procs" ]; then
  echo "Still using the GPU:" >&2
  echo "$procs" >&2
  echo "Close these first, or the unload will fail." >&2
fi

echo "Unloading NVIDIA modules..."
# Ordered leaves-first; modprobe -r would work the order out itself, but naming
# them makes a stuck module obvious in the error.
sudo modprobe -r nvidia_drm nvidia_modeset nvidia_uvm nvidia

# The device only autosuspends once nothing is bound to it, and udev's
# 80-nvidia-pm.rules flips power/control back to "on" at unbind -- which would
# pin it at D0 forever. Put it back to auto so it can actually drop.
echo auto | sudo tee "/sys/bus/pci/devices/$dev/power/control" >/dev/null

echo "PCI power state: $(state)"
[ "$(state)" = D0 ] &&
  echo "Warning: still D0; something may have reloaded the driver." >&2
exit 0
