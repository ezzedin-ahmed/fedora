#!/usr/bin/env bash
# k3s-up — start k3s for an on-demand testing session.
# Does NOT enable k3s at boot; that stays off for on-demand usage.
set -euo pipefail

echo "Starting k3s..."
sudo systemctl start k3s

echo "Waiting for the node to become Ready..."
for i in $(seq 1 60); do
  if kubectl get nodes 2>/dev/null | grep -qw Ready; then
    kubectl get nodes
    exit 0
  fi
  sleep 2
done

echo "Timed out waiting for the node to become Ready." >&2
echo "Check status with: systemctl status k3s" >&2
exit 1
