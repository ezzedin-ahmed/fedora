#!/usr/bin/env bash
# scratchterm — toggle a dropdown terminal, bound to $mod+` in ui/sway/config.
#
# The window lives in sway's scratchpad rather than being killed on close, so
# the shell, its jobs and its scrollback all survive a toggle. Sizing, floating
# and the first reveal are done by the for_window rule that matches this app_id;
# everything here does is spawn it once and toggle it thereafter.

set -Eeuo pipefail

APP_ID="scratchterm"

# `scratchpad show` is itself the toggle: it reveals a hidden window and hides a
# visible one. It only errors on an empty scratchpad, hence the tree check.
if swaymsg -t get_tree | jq -e --arg id "$APP_ID" \
    'recurse(.nodes[]?, .floating_nodes[]?) | select(.app_id == $id)' >/dev/null; then
    swaymsg "[app_id=\"^${APP_ID}\$\"] scratchpad show" >/dev/null
else
    exec alacritty --class "$APP_ID"
fi
